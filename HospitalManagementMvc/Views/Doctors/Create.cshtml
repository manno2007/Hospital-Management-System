@model Doctor
@{ ViewData["Title"] = "Add doctor"; }
<h1>Add doctor</h1><form asp-action="Create" method="post" class="card p-4 mt-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control mb-3" /><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" asp-items="ViewBag.DepartmentId" class="form-select mb-3"><option value="">Select department</option></select><button class="btn btn-primary">Save</button></form>