@model Appointment
@{ ViewData["Title"] = "Edit appointment"; }
<h1>Edit appointment</h1><form asp-action="Edit" method="post" class="card p-4 mt-3"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" class="form-control mb-3" /><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control mb-3"></textarea><label asp-for="PatientId" class="form-label"></label><select asp-for="PatientId" asp-items="ViewBag.PatientId" class="form-select mb-3"></select><label asp-for="DoctorId" class="form-label"></label><select asp-for="DoctorId" asp-items="ViewBag.DoctorId" class="form-select mb-3"></select><button class="btn btn-primary">Save</button></form>