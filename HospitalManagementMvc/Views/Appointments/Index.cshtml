@model IEnumerable<Appointment>
@{ ViewData["Title"] = "Appointments"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Appointments</h1><p class="text-muted">Manage patient visits and clinical notes.</p></div><a class="btn btn-primary" asp-action="Create">Schedule appointment</a></div>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Date</th><th>Patient</th><th>Doctor</th><th>Department</th><th>Description</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.AppointmentDate.ToString("dd MMM yyyy, HH:mm")</td><td>@item.Patient?.Name</td><td>@item.Doctor?.Name</td><td>@item.Doctor?.Department?.Name</td><td>@item.Description</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id">Details</a> · <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }
</tbody></table></div></div>