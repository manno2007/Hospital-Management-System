@model IEnumerable<Department>
@{ ViewData["Title"] = "Departments"; }
<div class="d-flex justify-content-between mb-4"><h1>Departments</h1><a class="btn btn-primary" asp-action="Create">Add department</a></div>
<table class="table table-striped bg-white"><thead><tr><th>Name</th><th>Doctors</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.Doctors.Count</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> · <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table>